  m_Script: {fileID: 11500000, guid: bd95f283a93917a43a8b8dc07174ccc4, type: 3}
  m_Name: InspectorLines_Gruff
  m_EditorClassIdentifier: CrateExpectations.Inspection::CrateExpectations.Inspection.InspectorLinesDefinition
  <Greeting>k__BackingField: "\u0421\u0442\u043E\u044F\u0442\u044C. \u0413\u0440\u0443\u0437
    \u043D\u0430 \u0441\u0442\u043E\u043B."
  _probes:
  - Aspect: 0
    Line: "\u0422\u0430\u043A... \u0447\u0442\u043E \u0443 \u043D\u0430\u0441 \u043F\u043E
      \u0434\u0435\u043A\u043B\u0430\u0440\u0430\u0446\u0438\u0438."
  - Aspect: 1
    Line: "\u041E\u043A\u0440\u0430\u0441\u043A\u0430. \u041F\u043E\u0440\u044F\u0434\u043E\u043A
      \u0432 \u043F\u043E\u0440\u0442\u0443 \u043D\u0435 \u044F \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B."
  - Aspect: 2
    Line: "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043B\u043E\u043C\u0431\u0430."
  - Aspect: 3
    Line: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u043C. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u0447\u0442\u043E \u0432\u043D\u0443\u0442\u0440\u0438."
  _reasons:
  - Clue: 0
    Line: "\u0412\u044B \u044D\u0442\u043E \u043F\u0440\u044F\u043C\u043E \u0432
      \u0431\u0443\u043C\u0430\u0433\u0430\u0445 \u0438 \u043D\u0430\u043F\u0438\u0441\u0430\u043B\u0438
      - \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043E \u043A \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0435!"
  - Clue: 1
    Line: "\u0412\u043D\u0443\u0442\u0440\u0438 \u0441\u043E\u0432\u0441\u0435\u043C
      \u043D\u0435 \u0442\u043E, \u0447\u0442\u043E \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u043E."
  - Clue: 2
    Line: "\u0426\u0432\u0435\u0442 \u043D\u0435 \u0442\u043E\u0442... \u0442\u0430\u043A\u043E\u0439
      \u0433\u0440\u0443\u0437 \u0442\u0430\u043A \u043D\u0435 \u043A\u0440\u0430\u0441\u044F\u0442."
  - Clue: 3
    Line: "\u041F\u043B\u043E\u043C\u0431\u044B \u043D\u0435\u0442 \u0432\u043E\u043E\u0431\u0449\u0435."
  - Clue: 4
    Line: "\u041F\u043B\u043E\u043C\u0431\u0430 \u0447\u0443\u0436\u0430\u044F, \u043D\u0435
      \u043D\u0430\u0448\u0430."
  - Clue: 5
    Line: "\u042F\u0449\u0438\u043A \u043D\u0435 \u043A\u0440\u0430\u0448\u0435\u043D.
      \u0421\u043E\u0432\u0441\u0435\u043C."
  <PassLine>k__BackingField: "\u041B\u0430\u0434\u043D\u043E. \u041F\u0440\u043E\u0435\u0437\u0436\u0430\u0439\u0442\u0435."
  <BustLine>k__BackingField: "\u0413\u0440\u0443\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043D,
    \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043E\u043A\u043E\u043D\u0447\u0435\u043D."
  <CleanLine>k__BackingField: "\u041F\u0440\u0438\u0434\u0440\u0430\u0442\u044C\u0441\u044F
    \u043D\u0435 \u043A \u0447\u0435\u043C\u0443."
  <PassColor>k__BackingField: {r: 0.078431375, g: 0.41960785, b: 0.13333334, a: 1}
  <BustColor>k__BackingField: {r: 0.60784316, g: 0.07058824, b: 0.047058824, a: 1}
  <MissingLine>k__BackingField: "\u2026"
