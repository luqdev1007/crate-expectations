    \u043F\u0440\u0438 \u043C\u0430\u043B\u0435\u0439\u0448\u0435\u043C \u043F\u043E\u0432\u043E\u0434\u0435
    \u0432\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u044F\u0449\u0438\u043A.
    \u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u0440\u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442."
